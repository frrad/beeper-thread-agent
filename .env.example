# Required for model calls
OPENROUTER_API_KEY=

# Pick any OpenRouter chat-completions model.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Beeper Desktop's local MCP endpoint (Beeper Desktop must be running).
BEEPER_MCP_URL=http://localhost:23373/v0/mcp

# Optional alternative to the browser OAuth flow. Generate in Beeper Desktop
# Settings -> Developers/Integrations, and keep it only in your local .env.
BEEPER_TOKEN=

# Optional defaults
POLL_INTERVAL_MS=2000
MAX_CONTEXT_MESSAGES=30
MAX_IMAGE_BYTES=4000000
